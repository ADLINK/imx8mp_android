From 187dba80c9b678fdc7720d0434de4cede641b917 Mon Sep 17 00:00:00 2001
From: shiva-adlink <shivashankar.t@adlinktech.com>
Date: Wed, 6 May 2026 12:58:16 +0530
Subject: [PATCH 3/3] Added-tlv320_config

Signed-off-by: shiva-adlink <shivashankar.t@adlinktech.com>
---
 common/audio-json/tlv320_config.json | 27 +++++++++++++++++++++++++++
 1 file changed, 27 insertions(+)
 create mode 100644 common/audio-json/tlv320_config.json

diff --git a/common/audio-json/tlv320_config.json b/common/audio-json/tlv320_config.json
new file mode 100644
index 00000000..131a5124
--- /dev/null
+++ b/common/audio-json/tlv320_config.json
@@ -0,0 +1,27 @@
+{
+  "driver_name": "tlv320aic3x",
+  "bus_name": "bus1_system_sound_out",
+  "supported_out_devices": ["speaker", "wired_headphone", "wired_headset", "bus", "line"],
+  "supported_in_devices": ["builtin_mic", "wired_headset"],
+  "support_lpa": 1,
+  "support_compress": 1,
+
+  "init_ctl": [
+    {"name": "Left Output Mixer PCM Playback Switch", "type": "int", "val": 1},
+    {"name": "Right Output Mixer PCM Playback Switch", "type": "int", "val": 1},
+    {"name": "PCM Playback Volume", "type": "int", "val": 230},
+    {"name": "HP DAC Playback Volume", "type": "int", "val": 100},
+    {"name": "HP Playback Volume", "type": "int", "val": 120}
+  ],
+
+  "builtin_mic_ctl": [
+    {"name": "ALC Function", "type": "int", "val": 3},
+    {"name": "Left Input Mixer Boost Switch", "type": "int", "val": 1},
+    {"name": "ADC PCM Capture Volume", "type": "int", "val": 230},
+    {"name": "Capture Volume", "type": "int", "val": 60}
+  ],
+
+  "out_volume_ctl": [
+    "Playback Volume"
+  ]
+}
